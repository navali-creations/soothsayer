{
  "name": "soothsayer",
  "productName": "Soothsayer",
  "version": "0.20.1",
  "private": true,
  "description": "Path of Exile divination card tracker",
  "license": "AGPL-3.0-or-later",
  "main": ".vite/build/main.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navali-creations/soothsayer.git"
  },
  "scripts": {
    "dev": "pnpm supabase:start && cross-env SOOTHSAYER_SUPABASE_TARGET=local electron-forge start",
    "start": "cross-env SOOTHSAYER_SUPABASE_TARGET=production electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "build:poe-process-helper": "node scripts/build-poe-process-helper.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "migration:biome": "biome migrate --write",
    "migration:create": "node main/modules/database/migrations/create-migration.ts",
    "supabase:start": "bash scripts/setup-local-dev.sh",
    "supabase:start:fresh": "bash scripts/setup-local-dev-fresh.sh",
    "supabase:stop": "bash scripts/stop-local-dev.sh",
    "supabase:sync": "bash scripts/sync-data.sh",
    "supabase:logs": "bash scripts/supabase-cli.sh functions serve --inspect-mode=run",
    "supabase:functions:serve": "bash scripts/supabase-cli.sh functions serve",
    "test": "node scripts/vitest-electron.mjs run --config vitest.main.config.mts && vitest run --config vitest.renderer.config.mts",
    "test:main": "node scripts/vitest-electron.mjs run --config vitest.main.config.mts",
    "test:main:coverage": "node scripts/vitest-electron.mjs run --config vitest.main.config.mts --coverage",
    "test:rust": "node scripts/run-msvc-cargo.mjs fmt --manifest-path helpers/poe-process-helper/Cargo.toml --all -- --check && node scripts/run-msvc-cargo.mjs clippy --manifest-path helpers/poe-process-helper/Cargo.toml --locked --all-targets -- -D warnings && node scripts/run-msvc-cargo.mjs test --manifest-path helpers/poe-process-helper/Cargo.toml --locked",
    "test:renderer": "vitest run --config vitest.renderer.config.mts",
    "test:renderer:coverage": "vitest run --config vitest.renderer.config.mts --coverage",
    "test:renderer:slices:coverage": "vitest run --config vitest.renderer.config.mts --coverage --coverage.include=\"renderer/modules/**/*.slice.ts\" \"slice.test\"",
    "test:e2e": "node scripts/build-e2e.mjs && pnpm test:e2e:run",
    "test:e2e:run": "cross-env E2E_TESTING=true playwright test --config playwright.config.ts",
    "test:supabase:db": "bash scripts/test-db.sh",
    "test:supabase:edge": "bash scripts/test-edge.sh",
    "test:all": "pnpm test:rust && node scripts/vitest-electron.mjs run --config vitest.main.config.mts && vitest run --config vitest.renderer.config.mts && bash scripts/test-db.sh && bash scripts/test-edge.sh && pnpm test:e2e"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.15.0",
  "keywords": [],
  "author": {
    "name": "Sebastian Krzyżanowski",
    "email": "eskrzy@gmail.com"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-base": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.61.1",
    "@redux-devtools/extension": "^4.0.0",
    "@repere/react": "^0.3.3",
    "@sentry/electron": "^7.17.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "app-builder-lib": "26.15.3",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.50",
    "dompurify": "^3.4.17",
    "electron": "45.0.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "esbuild": "0.28.2",
    "immer": "^11.2.9",
    "jsdom": "^30.0.1",
    "kysely": "^0.29.6",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "supabase": "^2.122.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@navali/poe1-divination-cards": "^3.29.1",
    "better-sqlite3": "^13.0.3",
    "tslib": "^2.8.1"
  }
}
